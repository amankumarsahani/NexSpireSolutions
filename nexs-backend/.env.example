# Napnix Admin Backend - Environment Variables

# ===========================================
# SERVER
# ===========================================
PORT=5000
NODE_ENV=production

# ===========================================
# DATABASE
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=napnix

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Control-plane root secret (32+ random chars). Tenant signing keys are derived from it.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# AI PROVIDERS + TENANT KEY ENCRYPTION
# ===========================================
# Must match the tenant backend secret when both services read the same settings DB.
AI_SETTINGS_SECRET=replace-with-a-long-random-secret-for-ai-settings
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=

# ===========================================
# EMAIL (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
SMTP_FROM_NAME=Napnix
SMTP_FROM_EMAIL=noreply@napnix.in

# ===========================================
# CLOUDFLARE (for tenant provisioning)
# ===========================================
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CF_CONFIG_PATH=/etc/cloudflared/config.yml

# ===========================================
# NEXCRM (Multi-tenant settings)
# ===========================================
NEXCRM_DOMAIN=napnix.in
NEXCRM_BACKEND_PATH=/var/www/html/nexcrm-backend
NEXCRM_PAGES_URL=nexcrm-frontend.pages.dev
NEXCRM_PAGES_PROJECT=nexcrm-frontend
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ===========================================
# NAP-LOAD (dynamic tenant routing/orchestration)
# ===========================================
# Comma-separated list of every nap-load instance's control-plane address.
# Full tenant routing table is pushed to ALL of these on every tenant
# create/update/delete. Leave empty to disable (route sync is skipped, not
# an error, if unset).
NAP_LOAD_ADDRESSES=

# ===========================================
# NAPNIX SUPER ADMIN (added to each tenant)
# ===========================================
NAPNIX_ADMIN_EMAIL=admin@napnix.in
# Leave empty to have provisioning generate a random strong password at
# runtime (logged once so it can be retrieved). Only set this if you need
# a fixed, known password across tenants.
NAPNIX_ADMIN_PASSWORD=

# ===========================================
# REGISTRY SERVICE (for mobile app lookup)
# ===========================================
REGISTRY_URL=https://registry.napnix.in
REGISTRY_API_KEY=your-registry-api-key

# ===========================================
# SUPPORT DESK (tenant CRM -> this master API)
# ===========================================
# Root secret used to DERIVE each tenant's unique support key (HMAC per slug).
# Optional — defaults to JWT_SECRET. This value NEVER leaves the master server;
# tenants only ever receive their own derived SUPPORT_TENANT_SECRET.
# SUPPORT_SIGNING_SECRET=
# New-ticket / customer-reply emails go to NOTIFICATION_EMAILS (comma-separated list, already
# used elsewhere). SUPPORT_NOTIFY_EMAIL / NAPNIX_ADMIN_EMAIL are single-address fallbacks only.
SUPPORT_NOTIFY_EMAIL=
# Admin panel base URL used in notification email links.
ADMIN_PANEL_URL=https://admin.napnix.in

# ===========================================
# RAZORPAY (Billing)
# ===========================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# APP URLS
# ===========================================
APP_URL=https://admin.napnix.in
API_URL=https://api.napnix.in

# Notification Recipients (comma-separated)
NOTIFICATION_EMAILS=ops@example.com,alerts@example.com

# ===========================================
# GOOGLE RECAPTCHA v3
# ===========================================
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ===========================================
# WHATSAPP SERVICE (nexs-whatsapp on port 5100)
# ===========================================
WHATSAPP_SERVICE_URL=http://localhost:5100
WHATSAPP_SERVICE_KEY=your-strong-random-key-same-as-nexs-whatsapp
# AES encryption key for Meta tokens stored in DB (defaults to JWT_SECRET if not set)
META_TOKEN_SECRET=your-meta-token-encryption-secret

# ===========================================
# GOOGLE OAUTH (centralized — Sheets lead-source today, Gmail later)
# ===========================================
# Create a Web application OAuth 2.0 Client in Google Cloud Console, enable the
# Google Sheets API, and set the authorized redirect URI to exactly:
#   ${API_URL}/oauth/google/callback   (see API_URL above)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Override only if the OAuth callback should live on a different domain than API_URL.
GOOGLE_OAUTH_REDIRECT_URI=
# Shared secret this server uses to hand refresh tokens off to tenant nexcrm-backend
# instances. Must match INTERNAL_OAUTH_KEY on every tenant instance.
INTERNAL_OAUTH_KEY=
# Dedicated state-signing secret shared with every tenant backend. If unset,
# INTERNAL_OAUTH_KEY remains the compatibility fallback.
OAUTH_STATE_SECRET=

# ===========================================
# SEO & SEARCH ENGINE INDEXING
# ===========================================
WEBSITE_URL=https://napnix.in
# IndexNow API key (auto-generated if empty, serves at /{key}.txt)
INDEXNOW_KEY=
# Google Indexing API (optional — service account JSON file path OR inline JSON)
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
